{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "venusian-scrapyard-presents/stargazer",
    "type": "project",
    "description": "Venusian framework-powered application that browses the NASA API.",
    "keywords": [
        "venusian",
        "framework",
        "skeleton"
    ],
    "version": "0.10.0",
    "license": "GPL-3.0-only",
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-fb": "*",
        "ext-dom": "*",
        "ext-pcurl": "*",
        "ext-imgdec": "*",
        "ext-rasterize": "*",
        "ext-pdo_sqlite": "*",
        "ext-xmlreader": "*",
        "ext-simplexml": "*",
        "ext-redis": "*",
        "venusian/surface": "^0.10.1",
        "venusian/framework": "^0.10.0",
        "jovian/venusian-gtk": "^0.10.2",
        "venusian/probe": "^0.10.0",
        "projectsaturnstudios/venusian-stargazer": "^0.10.0"
    },
    "suggest": {
        "php-io-extensions/pcurl": "(0.10.0) - exposes ext-pcurl for better cURL performance",
        "php-io-extensions/epoll": "(0.10.0) - exposes ext-epoll for native event-loop events on Linux",
        "php-io-extensions/kqueue": "(0.10.0) - exposes ext-epoll for native event-loop events on MacOS",
        "jovian/venusian-appkit": "(0.10.0) - AppKit-driven Windows",
        "jovian/venusian-gtk": "(0.10.0) - GTK-driven Windows",
        "jovian/venusian-qt": "(0.10.0) - Qt-driven Windows",
        "jovian/venusian-metal": "(0.10.0) - Metal-drawn Graphics",
        "jovian/venusian-vulkan": "(0.10.0) - Vulkan/MoltenVK-drawn Graphics",
        "jovian/venusian-sdl3": "(0.10.0) - SDL3-drawn Graphics",
        "jovian/venusian-opengl": "(0.10.0) - OpenGL-drawn Graphics"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@post-root-package-install",
            "@post-create-project-cmd"
        ],
        "test": [
            "@php vendor/bin/pest"
        ],
        "post-autoload-dump": [
            "Voyager\\Core\\ComposerScripts::postAutoloadDump",
            "@php computer package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php -r \"file_put_contents('.env', preg_replace('/^APP_KEY=(?=\\R)/m', 'APP_KEY=base64:'.base64_encode(random_bytes(32)), file_get_contents('.env')));\"",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\""
        ]
    },
    "extra": {
        "venusian": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
