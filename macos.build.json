{
    "id": "com.venusian.stargazer",
    "summary": "NASA's picture of the day, every day",
    "description": "Browse the Astronomy Picture of the Day by date, in HD when you want it.",
    "author": "Angel Gonzalez <usftechacg@gmail.com>",
    "homepage": "https://github.com/VenusianPHP",
    "license": "MIT",
    "category": "Education",
    "icon": "art/icon.png",
    "targets": [
        "macos-arm64"
    ],
    "extensions": [
        "pdo_sqlite",
        "imgdec"
    ],
    "env": {
        "TOOLKIT_BRIDGE": "appkit",
        "CACHE_STORE": "file",
        "QUEUE_CONNECTION": "sync",
        "APP_MEMORY_LIMIT": "512M"
    }
}
